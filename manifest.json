{
  "manifest_version": 3,
  "name": "BetterLET",
  "version": "1.23",
  "description": "A cleaner LowEndTalk: wide layout, compact rows, sorting, hide what you've seen.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BetterLET",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lowendtalk.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lowendtalk.com/*"
      ],
      "js": [
        "content.js",
        "popovers.js"
      ],
      "run_at": "document_end"
    }
  ]
}
